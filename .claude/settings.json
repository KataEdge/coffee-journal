{
  "permissions": {
    "allow": [
      "Bash(swift test:*)",
      "Bash(swift build:*)",
      "Bash(swiftlint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(gitleaks detect:*)",
      "Bash(gitleaks protect:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/gitleaks-guard.sh\""
          }
        ]
      }
    ]
  }
}
